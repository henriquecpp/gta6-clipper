# Copy to .env and fill in. Never commit .env.

# Twitch application (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Telegram bot (@BotFather) and the chat ids allowed to receive previews and send commands (comma separated)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Anthropic. The model is never hardcoded; see docs/decisions/0015 for the tool_choice note.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

LOG_LEVEL=info
