# Copy to .env and fill in. Never commit .env.

# Twitch application (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Telegram bot (@BotFather) and the chat ids allowed to receive previews and send commands (comma separated)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Anthropic. The model is never hardcoded; see docs/decisions/0015 for the tool_choice note.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# YouTube (optional): OAuth client of type "TVs and Limited Input devices" in a Google Cloud project with the
# YouTube Data API v3 enabled. Then run `task auth:youtube` once. Without it, nothing is published.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

LOG_LEVEL=info
